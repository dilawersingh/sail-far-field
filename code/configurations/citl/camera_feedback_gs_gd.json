{
  "paths": {
    "save_base": [
      "results/GD+CITL/experiments"
    ],
    "image_files": [
      "targets"
    ],
    "exposure_settings": [
      "code/configurations/citl/exposure_settings.json"
    ],
    "simulation_comparison_base": [
      "results/GD+CITL/simulations"
    ]
  },
  "dataset_name": "Synthetic - PyTorch",
  "experiment": {
    "description": "Starting with the calculated GS and GD holograms from simulation, give each direct camera feedback at every iteration, substituted into their own existing algorithms (no learned model, no corrector). One target image, 25 iterations GS then 750 iterations GD.",
    "overwrite": false
  },
  "hardware": {
    "slm_shape": [
      1080,
      1920
    ],
    "dc_radius": 20,
    "dc_auto_center": false,
    "dc_center": [
      495,
      510
    ],
    "settle_time_s": 0.3,
    "capture_timeout_s": 15.0,
    "dll_path": "C:/path/to/EDSDK.dll",
    "calibration_mode": "manual",
    "manual_alignment": {
      "x0": 1083,
      "y0": 129,
      "w": 3267,
      "h": 3265,
      "rotation_deg": -0.06
    }
  },
  "run": {
    "height": 1000,
    "width": 1000,
    "gs_iterations": 25,
    "gd_iterations": 750,
    "target_formulation": "amplitude",
    "gs_lowpass": false,
    "gs_add_carrier": false,
    "gd_lr": 0.03,
    "gd_optimizer_name": "adam",
    "gd_tv_weight": 0.0,
    "calib_burnin_iterations": 200,
    "save_all_iteration_pngs": false
  },
  "conditions": [
    {
      "physics_name": "ideal",
      "pad_factor": 1,
      "apply_sinc": false,
      "fill_factor": 1,
      "fill_is_areal": true,
      "init_variants": [
        {
          "init_name": "random_init",
          "gs_init_phase": "random",
          "gd_init_phase": "random"
        },
        {
          "init_name": "warm_start",
          "gs_init_phase": "warm_start",
          "gd_init_phase": "warm_start"
        }
      ]
    },
    {
      "physics_name": "faithful",
      "pad_factor": 2,
      "apply_sinc": true,
      "fill_factor": 0.91,
      "fill_is_areal": true,
      "init_variants": [
        {
          "init_name": "random_init",
          "gs_init_phase": "random",
          "gd_init_phase": "random"
        },
        {
          "init_name": "warm_start",
          "gs_init_phase": "warm_start",
          "gd_init_phase": "warm_start"
        }
      ]
    }
  ]
}